# Settings and secrets for osu-rotate, installed to /etc/osu-rotate/secrets.env (root only).
# Deploys never overwrite this file. Apply changes with: sudo systemctl restart osu-rotate
# Use __ where appsettings.json has nesting: Osu:ClientSecret becomes Osu__ClientSecret.
#
# The osu! account the bot runs on (yours) and its IRC password from
# https://osu.ppy.sh/home/account/edit#legacy-api. Without both, the bot does not connect.
#Bancho__Nick=
#Bancho__Password=
#
# An osu! OAuth application (https://osu.ppy.sh/home/account/edit#oauth) for map checks and recovery.
# Without it, maps are let through and recovery cannot tell whether a match is running.
#Osu__ClientId=
#Osu__ClientSecret=
#
# The database lives in /var/lib/osu-rotate/rotate.db unless this says otherwise.
#Bot__DatabasePath=
