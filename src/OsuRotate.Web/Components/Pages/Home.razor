@page "/"
@using OsuRotate.Application
@using OsuRotate.Web.Bot
@using OsuRotate.Web.Components.Lobby
@attribute [Authorize(Policy = OsuRotate.Web.Auth.OwnerAuthentication.OwnerPolicy)]
@implements IDisposable
@inject LobbyRuntime Runtime

<PageTitle>osu-rotate</PageTitle>

<h1 class="page-title">Lobby</h1>

@* The desk: the room on the left (status, the match, the players), its chat and the rarely used
   controls beside it. app.css orders the sections; with no room open, creating one comes first.
   The rules have their own page. *@
<div class="desk @(_snapshot?.RoomId is null ? "no-room" : null)">
    <div class="desk-main">
        <LobbyView Snapshot="_snapshot" />
        <QueueControls Snapshot="_snapshot" />
        <LifecycleControls Snapshot="_snapshot" />
    </div>
    <aside class="desk-side">
        <ChatPanel Snapshot="_snapshot" />
        <ModerationPanel Snapshot="_snapshot" />
    </aside>
</div>

@code {
    private LobbySnapshot? _snapshot;

    protected override void OnInitialized()
    {
        _snapshot = Runtime.Snapshot;
        Runtime.Changed += OnChanged;
    }

    // Called on the actor's loop. InvokeAsync only queues the render on this page's circuit, so a
    // slow browser never holds up the lobby.
    private void OnChanged(LobbySnapshot? snapshot) =>
        _ = InvokeAsync(() =>
        {
            _snapshot = snapshot;
            StateHasChanged();
        });

    public void Dispose() => Runtime.Changed -= OnChanged;
}
