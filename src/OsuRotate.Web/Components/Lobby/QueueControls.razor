@using OsuRotate.Application
@using OsuRotate.Domain
@using OsuRotate.Web.Bot
@inject LobbyRuntime Runtime

@* The match: start it, stop the countdown, abort it, or pass host on. These act at once, whatever
   the votes say. Moving players in the queue is on each player's row in the player list. *@

@if (Snapshot is { Status: LobbyStatus.Open })
{
    <section class="lobby-host-controls" aria-label="Match">
        <h2>Match</h2>
        <div class="match-controls">
            @if (QueueActions.CanStart(Snapshot))
            {
                <form class="start" @onsubmit="StartAsync">
                    <label>Countdown <input @bind="_countdown" inputmode="numeric" placeholder="0" size="4" aria-describedby="countdown-hint" /></label>
                    <button type="submit" disabled="@_busy">Start match</button>
                </form>
            }
            @if (QueueActions.CanCancelCountdown(Snapshot))
            {
                <button class="cancel-countdown" disabled="@_busy" @onclick="() => RunAsync(() => Actions.CancelCountdownAsync())">Stop the countdown</button>
            }
            @if (QueueActions.CanAbort(Snapshot))
            {
                <button class="abort" disabled="@_busy" @onclick="() => RunAsync(() => Actions.AbortAsync())">Abort the match</button>
            }
            @if (QueueActions.CanSkip(Snapshot))
            {
                <button class="skip" disabled="@_busy" @onclick="() => RunAsync(() => Actions.SkipHostAsync())">Skip the host</button>
            }
        </div>
        @if (QueueActions.CanStart(Snapshot))
        {
            <p class="hint" id="countdown-hint">Seconds to wait before the match starts. Leave it empty to start now.</p>
        }
        else if (Snapshot.Players.Count == 0)
        {
            <p class="hint">A match can start once someone is in the room.</p>
        }
        @if (_message is not null)
        {
            <p class="message" role="status">@_message</p>
        }
    </section>
}

@code {
    private QueueActions? _actions;
    private string? _countdown;
    private string? _message;
    private bool _busy;

    [Parameter]
    public LobbySnapshot? Snapshot { get; set; }

    private QueueActions Actions => _actions ??= new QueueActions(Runtime);

    private Task StartAsync() => RunAsync(() => Actions.StartAsync(_countdown));

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _message = null;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
