@using OsuRotate.Application
@using OsuRotate.Domain
@using OsuRotate.Web.Bot
@inject LobbyRuntime Runtime

@* The players who are never given host. Players in the room are added from their row in the
   player list; this is for names that are not in the room, and for taking a name off again. *@

@if (Snapshot is not null)
{
    <section class="lobby-moderation" aria-label="Never host">
        <h2>Never host</h2>
        <p class="lede">These players can join and play, but the queue skips them.</p>
        @if (Snapshot.Denied.Count == 0)
        {
            <p class="empty">Nobody.</p>
        }
        else
        {
            <ul class="denied">
                @foreach (var key in Snapshot.Denied)
                {
                    <li>
                        <span class="name">@key</span>
                        <button class="allow" disabled="@_busy" @onclick="() => RunAsync(() => Actions.AllowAsync(key))">Allow again</button>
                    </li>
                }
            </ul>
        }
        <form class="deny-name" @onsubmit="DenyNameAsync">
            <label>Never give host to <input @bind="_denyName" placeholder="osu! username" autocomplete="off" /></label>
            <button type="submit" disabled="@_busy">Add</button>
        </form>
        @if (_message is not null)
        {
            <p class="message" role="status">@_message</p>
        }
    </section>
}

@code {
    private ModerationActions? _actions;
    private string? _denyName;
    private string? _message;
    private bool _busy;

    [Parameter]
    public LobbySnapshot? Snapshot { get; set; }

    private ModerationActions Actions => _actions ??= new ModerationActions(Runtime);

    private Task DenyNameAsync() => RunAsync(async () =>
    {
        var message = await Actions.DenyAsync(_denyName);
        if (message is null)
        {
            _denyName = null;
        }

        return message;
    });

    private async Task RunAsync(Func<Task<string?>> action)
    {
        _busy = true;
        _message = null;
        try
        {
            _message = await action();
        }
        finally
        {
            _busy = false;
        }
    }
}
