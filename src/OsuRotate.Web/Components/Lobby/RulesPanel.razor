@using OsuRotate.Application
@using OsuRotate.Domain
@using OsuRotate.Web.Bot
@inject LobbyRuntime Runtime

@* UC8. The form is filled from the lobby once and then left to the owner until saved or reset. *@

@if (_form is not null)
{
    <section class="lobby-rules" aria-label="Rules">
        <h2>Rules</h2>
        <form class="rules" @onsubmit="SaveAsync">
            <fieldset class="settings-section">
                <legend>Map regulation</legend>
                <ToggleRow Label="Check maps" Hint="Reject picks outside these rules" @bind-Value="_form.RegulationEnabled" />
                <TilePicker TValue="GameMode" Label="Game mode" Hint="Maps in other modes are rejected" Items="GameModes" Columns="4" Compact="true" @bind-Value="_form.Mode" />
                <ToggleRow Label="Allow converts" Hint="osu! maps played in this mode" @bind-Value="_form.AllowConvert" />
                <SliderRow Label="Lowest star rating" Min="0" Max="10" Step="0.01" Format="Stars" Zero="No limit" @bind-Value="_form.StarMin" />
                <SliderRow Label="Highest star rating" Min="0" Max="10" Step="0.01" Format="Stars" Zero="No limit" @bind-Value="_form.StarMax" />
                <NumberRow Label="Shortest length" Hint="0 for no limit" Unit="s" Min="0" @bind-Value="_form.LengthMinSeconds" />
                <NumberRow Label="Longest length" Hint="0 for no limit" Unit="s" Min="0" @bind-Value="_form.LengthMaxSeconds" />
                <NumberRow Label="Rejected picks before losing the turn" Hint="0 for no limit" Min="0" @bind-Value="_form.ViolationsAllowed" />
            </fieldset>

            <fieldset class="settings-section">
                <legend>Room</legend>
                <label class="form-row text-row">
                    <span class="form-text">
                        <span class="form-label">Room name</span>
                        <span class="form-hint">Kept as the room's title; empty leaves it alone</span>
                    </span>
                    <input @bind="_form.Title" maxlength="@RoomKeeping.MaxTitleLength" autocomplete="off" />
                </label>
                <ToggleRow Label="Keep the game type" Hint="Head to head or teams, and how scores count" @bind-Value="_form.KeepMode" />
                @if (_form.KeepMode)
                {
                    <TilePicker TValue="TeamMode" Label="Game type" Items="TeamModes" @bind-Value="_form.Team" />
                    <TilePicker TValue="ScoreMode" Label="Win condition" Items="ScoreModes" Columns="4" Compact="true" @bind-Value="_form.Score" />
                }
                <SliderRow Label="Player slots" Min="0" Max="@KeepCommand.MaxSize" Step="1" Format="Slots" Zero="Not kept" @bind-Value="Size" />
                <TilePicker TValue="PasswordKeeping" Label="Password" Items="Passwords" Columns="3" Compact="true" @bind-Value="_form.Password" />
                @if (_form.Password == PasswordKeeping.Set)
                {
                    <label class="form-row text-row">
                        <span class="form-text"><span class="form-label">New password</span></span>
                        <input type="password" autocomplete="new-password" @bind="_form.NewPassword" placeholder="@(_hasPassword ? "unchanged" : null)" />
                    </label>
                }
                <ToggleRow Label="Keep the mods" Hint="Put back if someone changes them" @bind-Value="_form.KeepMods" />
                @if (_form.KeepMods)
                {
                    <ModPicker @bind-Value="_form.ModsText" />
                }
            </fieldset>

            <fieldset class="settings-section">
                <legend>Votes</legend>
                <SliderRow Label="Skip the host" Hint="Share of players needed" Min="0" Max="1" Step="0.05" Format="Percent" @bind-Value="_form.SkipShare" />
                <NumberRow Label="Skip votes at least" Min="1" @bind-Value="_form.SkipMinimum" />
                <SliderRow Label="Start the match" Hint="Share of players needed" Min="0" Max="1" Step="0.05" Format="Percent" @bind-Value="_form.StartShare" />
                <NumberRow Label="Start votes at least" Min="1" @bind-Value="_form.StartMinimum" />
                <ToggleRow Label="Start when everyone is ready" @bind-Value="_form.StartWhenAllReady" />
                <SliderRow Label="Abort the match" Hint="Share of players needed" Min="0" Max="1" Step="0.05" Format="Percent" @bind-Value="_form.AbortShare" />
                <NumberRow Label="Abort votes at least" Min="1" @bind-Value="_form.AbortMinimum" />
            </fieldset>

            <fieldset class="settings-section">
                <legend>AFK</legend>
                <ToggleRow Label="Skip an AFK host" @bind-Value="_form.SkipAfkHost" />
                <NumberRow Label="First host check" Unit="s" Min="0" @bind-Value="_form.HostAfkFirstCheckSeconds" />
                <NumberRow Label="Check the host every" Hint="0 turns it off" Unit="s" Min="0" @bind-Value="_form.HostAfkCheckIntervalSeconds" />
                <ToggleRow Label="Kick AFK players" @bind-Value="_form.AfkKickEnabled" />
                <NumberRow Label="Kick after this many points" Min="1" @bind-Value="_form.AfkKickThreshold" />
                <NumberRow Label="Kick cooldown" Unit="s" Min="10" @bind-Value="_form.AfkKickCooldownSeconds" />
            </fieldset>

            <fieldset class="settings-section">
                <legend>Matches</legend>
                <ToggleRow Label="Auto start" Hint="Start a while after an accepted pick" @bind-Value="_form.AutoStartEnabled" />
                <ToggleRow Label="Auto start clears the host" @bind-Value="_form.AutoStartClearsHost" />
                <NumberRow Label="Auto start after" Unit="s" Min="15" @bind-Value="_form.AutoStartDelaySeconds" />
                <ToggleRow Label="Abort a stuck match" @bind-Value="_form.AbortStuckMatch" />
                <SliderRow Label="Stuck once this share finished" Min="0" Max="1" Step="0.05" Format="Percent" @bind-Value="_form.StuckMatchFinishedShare" />
                <NumberRow Label="and still running after" Hint="0 turns it off" Unit="s" Min="0" @bind-Value="_form.StuckMatchDelaySeconds" />
                <NumberRow Label="Kick a host who kicks this many players" Hint="0 turns it off" Min="0" @bind-Value="_form.HostKickTolerance" />
                <NumberRow Label="Check for host kicks every" Unit="s" Min="10" @bind-Value="_form.HostKickCheckIntervalSeconds" />
            </fieldset>

            <fieldset class="settings-section">
                <legend>Info message</legend>
                <label class="form-row text-row stacked">
                    <span class="form-text">
                        <span class="form-label">Said for !info and !help</span>
                        <span class="form-hint">${version} becomes the running version; each line is said separately</span>
                    </span>
                    <textarea rows="4" @bind="_form.InfoMessage"></textarea>
                </label>
                <NumberRow Label="Say it every" Hint="0 turns it off" Unit="s" Min="0" @bind-Value="_form.InfoAnnouncementIntervalSeconds" />
            </fieldset>

            <div class="form-actions">
                <button type="submit" disabled="@_busy">Save rules</button>
                <button type="button" class="reset" disabled="@_busy" @onclick="Reset">Reset</button>
            </div>
        </form>

        @if (_message is not null)
        {
            <p class="message" role="status">@_message</p>
        }
    </section>
}

@code {
    private static readonly IReadOnlyList<TileChoice<GameMode>> GameModes =
        [.. Enum.GetValues<GameMode>().Select(m => new TileChoice<GameMode>(m, m.OfficialName()))];

    private static readonly IReadOnlyList<TileChoice<TeamMode>> TeamModes =
    [
        new(TeamMode.HeadToHead, "Head to head", "Everyone for themselves"),
        new(TeamMode.TagCoop, "Tag co-op", "Take turns, together"),
        new(TeamMode.TeamVs, "Team VS", "Red against blue"),
        new(TeamMode.TagTeamVs, "Tag team VS", "Teams taking turns"),
    ];

    private static readonly IReadOnlyList<TileChoice<ScoreMode>> ScoreModes =
    [
        new(ScoreMode.Score, "Score"),
        new(ScoreMode.Accuracy, "Accuracy"),
        new(ScoreMode.Combo, "Combo"),
        new(ScoreMode.ScoreV2, "Score V2"),
    ];

    private static readonly IReadOnlyList<TileChoice<PasswordKeeping>> Passwords =
    [
        new(PasswordKeeping.NotKept, "Not kept"),
        new(PasswordKeeping.Open, "No password"),
        new(PasswordKeeping.Set, "Password"),
    ];

    private static string Stars(double value) => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + "★";

    private static string Percent(double value) => value.ToString("0%", System.Globalization.CultureInfo.InvariantCulture);

    private static string Slots(double value) => value.ToString("0", System.Globalization.CultureInfo.InvariantCulture);

    // The slots slider works in doubles; the form keeps a whole number.
    private double Size
    {
        get => _form?.Size ?? 0;
        set
        {
            if (_form is not null)
            {
                _form.Size = (int)Math.Round(value);
            }
        }
    }

    private RuleForm? _form;
    private RuleActions? _actions;
    private string? _message;
    private bool _busy;
    private bool _hasPassword;

    [Parameter]
    public LobbySnapshot? Snapshot { get; set; }

    private RuleActions Actions => _actions ??= new RuleActions(Runtime);

    protected override void OnParametersSet()
    {
        if (_form is null && Snapshot is not null)
        {
            Reset();
        }
    }

    private void Reset()
    {
        if (Snapshot is not null)
        {
            _form = RuleForm.From(Snapshot.Settings);
            _hasPassword = Snapshot.Settings.Keeping.Password is { Length: > 0 };
            _message = null;
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            _message = await Actions.SaveAsync(_form) ?? "Saved.";
            if (_message == "Saved.")
            {
                _hasPassword |= _form.Password == PasswordKeeping.Set;
                _form.NewPassword = null;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
