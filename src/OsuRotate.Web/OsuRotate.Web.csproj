<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The Web SDK defaults to server GC, which reserves far more memory than one lobby needs on a Pi. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Nothing here is culture-sensitive, and this removes the libicu dependency on the Pi. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OsuRotate.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsuRotate.Application\OsuRotate.Application.csproj" />
    <ProjectReference Include="..\OsuRotate.Infrastructure\OsuRotate.Infrastructure.csproj" />
  </ItemGroup>

</Project>
